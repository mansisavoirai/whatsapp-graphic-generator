    {
      "parameters": {
        "jsCode": "const templateBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst templateHtml = templateBuffer.toString('utf8');\n\nconst productData = $('Code in JavaScript').item.json;\nconst photoBuffer = await this.helpers.getBinaryDataBuffer(0, 'photo');\nconst photoMimeType = items[0].binary.photo.mimeType;\nconst photoBase64 = photoBuffer.toString('base64');\nconst photoDataUri = `data:${photoMimeType};base64,${photoBase64}`;\n\nconst filledHtml = templateHtml\n  .replace(/\\{\\{stability_bg_url\\}\\}/g, productData.stability_bg_data_uri || '')\n  .replace(/\\{\\{product_photo_url\\}\\}/g, photoDataUri)\n  .replace(/\\{\\{product_name\\}\\}/g, productData.product_name || 'Product')\n  .replace(/\\{\\{price\\}\\}/g, productData.price || '')\n  .replace(/\\{\\{tagline\\}\\}/g, productData.tagline || '');\n\nreturn [{ json: { filledHtml: filledHtml } }];"
      },
