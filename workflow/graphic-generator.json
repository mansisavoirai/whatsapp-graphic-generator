        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a product detail extractor and copywriter for a hardware trading business in India. Extract product information from the voice note transcript and write a short promotional tagline. Always respond with valid JSON only — no extra text before or after.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Extract product details from this voice note transcript and write a tagline.\\nTranscript: {{ JSON.parse($node['HTTP Request2'].json.data).text }}\\n\\nReturn this exact JSON:\\n{\\n\\\"product_name\\\": \\\"name of the product\\\",\\n\\\"price\\\": \\\"price with currency symbol e.g. ₹450 or $12\\\",\\n\\\"key_feature\\\": \\\"main benefit or offer mentioned, max 6 words\\\",\\n\\\"tagline\\\": \\\"punchy promotional line, 6-8 words, in the same language as the transcript\\\",\\n\\\"language\\\": \\\"English\\\" or \\\"Hindi\\\" or \\\"Gujarati\\\"\\n}\\n\\nRules: never translate — match the language of the trader. Hindi in Devanagari script, Gujarati in Gujarati script. Hardware product taglines should emphasise quality, durability, price value, or availability.\"\n    }\n  ]\n}",
        "options": {}
      },
