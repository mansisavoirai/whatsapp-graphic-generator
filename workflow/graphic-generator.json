        "jsCode": "const items = $input.all();\nconst sheetData = items[0].json;\n\nconst storedDateRaw = sheetData['Date'] || sheetData.date || '';\nconst storedCountRaw = sheetData['Count'] || sheetData.count || '0';\n\nlet storedDate = '';\nif (typeof storedDateRaw === 'string') {\n  storedDate = storedDateRaw.trim();\n} else if (storedDateRaw instanceof Date) {\n  storedDate = storedDateRaw.toISOString().split('T')[0];\n}\n\nconst storedCount = parseInt(storedCountRaw, 10) || 0;\nconst istOffset = 5.5 * 60 * 60 * 1000; // 5.5 hours in milliseconds\nconst istDate = new Date(Date.now() + istOffset);\nconst today = istDate.toISOString().split('T')[0];\nlet currentCount = storedCount;\nlet needsReset = false;\n\nif (storedDate !== today) {\n  currentCount = 0;\n  needsReset = true;\n}\n\nreturn [{\n  json: {\n    storedDate,\n    storedCount,\n    currentCount,\n    today,\n    needsReset,\n    canUsePremium: currentCount < 23,\n  }\n}];"
