    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst artifacts = response.artifacts;\n\nif (!artifacts || artifacts.length === 0) {\n  throw new Error('Stability AI returned no artifacts. Check API key and quota.');\n}\n\nconst base64Image = artifacts[0].base64;\nconst finishReason = artifacts[0].finishReason;\n\nif (finishReason !== 'SUCCESS') {\n  console.warn(`Stability AI finish reason: ${finishReason}`);\n}\n\nconst dataUri = `data:image/png;base64,${base64Image}`;\n\nreturn [{\n  json: {\n    ...($input.first().json),\n    stability_bg_data_uri: dataUri,\n    stability_finish_reason: finishReason,\n  }\n}];"
